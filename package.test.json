{
  "name": "bolt-new-test-automation",
  "version": "1.0.0",
  "description": "Playwright test automation suite for bolt-new application",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test tests/e2e/smoke",
    "test:critical": "playwright test tests/e2e/critical",
    "test:regression": "playwright test tests/e2e/regression",
    "test:chromium": "playwright test --project=chromium",
    "test:staging": "playwright test --config=playwright.staging.config.ts",
    "test:report": "playwright show-report",
    "test:trace": "playwright show-trace",
    "test:codegen": "playwright codegen",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint tests/**/*.ts",
    "lint:fix": "eslint tests/**/*.ts --fix",
    "format": "prettier --write tests/**/*.ts",
    "format:check": "prettier --check tests/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "automation",
    "typescript"
  ],
  "author": "QA Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.15.1",
    "eslint": "^8.56.0",
    "eslint-plugin-playwright": "^0.20.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
